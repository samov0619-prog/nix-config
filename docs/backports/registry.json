{
  "schema": 1,
  "coverageExclusions": {
    "pkgs/installer-vpn/default.nix": "Template substitution in our own wrapper, not an upstream source fix.",
    "home/linux/modules/ardour/package.nix": "Native startup-theme wrapper/desktop entry customization, not an upstream source fix."
