      "upstream": ["12997a385f71", "2926eb396711"],
      "removeWhen": "All unpatched-source PM/D-state contracts pass; retain harness and verify real Hibernate/Bluetooth separately.",
      "details": "hosts/laptop/bluetooth-pm.md"
    },
    {
      "id": "pipewire-x11",
