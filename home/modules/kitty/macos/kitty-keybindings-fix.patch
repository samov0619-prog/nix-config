diff --git a/kitty.conf b/kitty.conf
--- a/kitty.conf
+++ b/kitty.conf
@@ -1,10 +1,10 @@
 # Command launches and tab controls, with EN/RU layout fallback.
-map --allow-fallback=shifted,ascii cmd+, launch --type=tab --cwd=~
-map --allow-fallback=shifted,ascii cmd+shift+, launch --type=os-window --cwd=current
-map --allow-fallback=shifted,ascii cmd+e launch --type=tab --cwd=~ env EDITOR=nvim yazi
-map --allow-fallback=shifted,ascii cmd+shift+e launch --type=os-window --cwd=current env EDITOR=nvim yazi
-map --allow-fallback=shifted,ascii cmd+n launch --type=tab --cwd=~ nvim
-map --allow-fallback=shifted,ascii cmd+shift+n launch --type=os-window --cwd=current nvim
+map --allow-fallback=shifted,ascii cmd+, new_tab
+map --allow-fallback=shifted,ascii cmd+shift+, no_op
+map --allow-fallback=shifted,ascii cmd+e launch --type=tab --cwd=~ --tab-title=yazi fish -l -c yazi
+map --allow-fallback=shifted,ascii cmd+shift+e no_op
+map --allow-fallback=shifted,ascii cmd+n launch --type=tab --cwd=~ --tab-title=nvim fish -l -c nvim
+map --allow-fallback=shifted,ascii cmd+shift+n no_op
 map --allow-fallback=shifted,ascii cmd+w close_tab
 map --allow-fallback=shifted,ascii cmd+[ previous_tab
 map --allow-fallback=shifted,ascii cmd+] next_tab
