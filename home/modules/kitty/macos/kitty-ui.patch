+active_tab_foreground #F5F6F8
+active_tab_background #4B6D79
+inactive_tab_foreground #C7CBD4
+inactive_tab_background #455360
+active_border_color #525866
+inactive_border_color #2C2E34
diff --git a/light-theme.auto.conf b/light-theme.auto.conf
