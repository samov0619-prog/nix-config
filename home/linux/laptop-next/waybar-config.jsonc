{
  "layer": "top",
  "modules-left": ["tray", "hyprland/workspaces", "hyprland/window"],
  "modules-center": [
    "custom/startup",
    "cpu",
    "memory",
    "custom/disk",
    "network",
    "custom/nix-updates",
  ],
  "modules-right": [
    "power-profiles-daemon",
    "battery",
    "pulseaudio",
    "hyprland/language",
    "clock",
  ],
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "{previous_profile_label} ← ПКМ | {profile_label} | ЛКМ → {next_profile_label}",
    "profile-labels": {
      "power-saver": "Сбережение",
      "balanced": "Баланс",
      "performance": "Производительность",
    },
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },
  "battery": {
    // Discover the target battery rather than inheriting Acer's BAT1.
    "interval": 30,
    "states": { "warning": 30, "critical": 15 },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
      "on-charging-100": "notify-send -u normal 'Battery Full!'",
    },
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
  },
  "hyprland/language": { "format": "{}", "format-en": "US", "format-ru": "RU" },
  "hyprland/window": {
    "format": "{}",
    "rewrite": { "(.*)": "" },
    "separate-outputs": true,
    "icon": true,
  },
  "clock": { "tooltip-format": "{:%d-%m-%Y}" },
  "cpu": {
    "interval": 5,
    "format": "cpu:{usage}% ",
    "max-length": 9,
    "min-length": 9,
  },
  "memory": {
    "interval": 5,
    "format": "ram:{used} swap:{swapUsed} ",
    "min-length": 19,
    "max-length": 19,
  },
  "custom/disk": {
    "exec": "~/.config/waybar/scripts/disk-status",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": true,
  },
  // No periodic nvidia-smi: establish dGPU idle/power management on the target first.
  "custom/startup": {
    "format": " ",
    "exec": "~/.config/waybar/scripts/startup-time.sh",
    "interval": "once",
    "tooltip": true,
    "tooltip-format": "{text}",
    "return-type": "json",
  },
  "custom/nix-updates": {
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/nix-updates-view.sh",
    "signal": 10,
    "on-click": "~/.config/waybar/scripts/check-nix-updates.sh && pkill -RTMIN+10 waybar",
    "tooltip": true,
  },
  "network": {
    "format-wifi": "{bandwidthDownBytes:>}⬇️ {bandwidthUpBytes:>}⬆️ ",
    "format-ethernet": "{bandwidthDownBytes:>}⬇️ {bandwidthUpBytes:>}⬆️ ",
    "format-disconnected": "x",
    "interval": 5,
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-muted": "{volume}%  {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""],
    },
    "on-click": "pwvucontrol",
  },
  "tray": { "icon-size": 21, "spacing": 10 },
}
