{
  "layer": "top",
  "modules-left": ["tray", "hyprland/workspaces", "hyprland/window"],
  "modules-center": [
    "custom/startup",
    "cpu",
    "memory",
    "custom/disk",
    "custom/gpu-manual",
    "network",
    "custom/nix-updates",
  ],
  "modules-right": [
    "power-profiles-daemon",
    "battery",
    "pulseaudio",
    "hyprland/language",
    "clock",
  ],
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "{previous_profile_label} ← ПКМ | {profile_label} | ЛКМ → {next_profile_label}",
    "profile-labels": {
      "power-saver": "Сбережение",
      "balanced": "Баланс",
      "performance": "Производительность",
    },
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },
  "battery": {
    // Discover the target battery rather than inheriting Acer's BAT1.
    "interval": 30,
    "states": { "warning": 15, "critical": 2, "normal": 99, "full": 100 },
    "events": {
      "on-discharging-warning": "~/.config/waybar/scripts/battery-notify warning",
      "on-discharging-critical": "~/.config/waybar/scripts/battery-notify critical",
      "on-charging-critical": "~/.config/waybar/scripts/battery-notify clear",
      "on-charging-warning": "~/.config/waybar/scripts/battery-notify clear",
      "on-charging-normal": "~/.config/waybar/scripts/battery-notify clear",
      "on-charging-full": "~/.config/waybar/scripts/battery-notify full",
    },
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
  },
  "hyprland/language": { "format": "{}", "format-en": "US", "format-ru": "RU" },
  "hyprland/window": {
    "format": "{}",
    "rewrite": { "(.*)": "" },
    "separate-outputs": true,
    "icon": true,
  },
  "clock": { "tooltip-format": "{:%d-%m-%Y}" },
  "cpu": {
    "interval": 5,
    "format": "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span> {usage}%",
    "tooltip-format": "Intel Core Ultra 7 356H\nЗагрузка CPU: {usage}%",
  },
  "memory": {
    "interval": 5,
    "format": "<span font_family='NotoSansM Nerd Font Mono' size='larger'></span> {percentage}%",
    "tooltip-format": "Оперативная память\nЗанято: {used:.1f} / {total:.1f} GiB\nSwap: {swapUsed:.1f} / {swapTotal:.1f} GiB",
  },
  "custom/disk": {
    "exec": "~/.config/waybar/scripts/disk-status --compact",
    "format": "<span font_family='NotoSansM Nerd Font Mono' size='larger'></span> {}",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": true,
  },
  // GPU queries are explicitly enabled by a click, for at most 60 seconds.
  "custom/gpu-manual": {
    "exec": "~/.config/waybar/scripts/gpu-status",
    "return-type": "json",
    "restart-interval": 5,
    "exec-on-event": false,
    "on-click": "~/.config/waybar/scripts/gpu-status --activate",
    "tooltip": true,
  },
  "custom/startup": {
    "format": "",
    "exec": "~/.config/waybar/scripts/startup-time.sh",
    "interval": "once",
    "tooltip": true,
    "tooltip-format": "{text}",
    "return-type": "json",
  },
  "custom/nix-updates": {
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/nix-updates-view.sh",
    "signal": 10,
    "on-click": "~/.config/waybar/scripts/check-nix-updates.sh && pkill -RTMIN+10 waybar",
    "tooltip": true,
  },
  "network": {
    "format-wifi": "↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "format-ethernet": "↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "format-disconnected": "x",
    "interval": 5,
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%   {format_source}",
    "format-muted": "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span> off   {format_source}",
    "format-bluetooth": "{icon}<span font_family='NotoSansM Nerd Font Propo' size='larger'></span> {volume}%   {format_source}",
    "format-bluetooth-muted": "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span> off   {format_source}",
    "format-source": "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span> {volume}%",
    "format-source-muted": "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span> off",
    "format-icons": {
      "headphone": "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span>",
      "headset": "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span>",
      "default": [
        "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span>",
        "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span>",
        "<span font_family='NotoSansM Nerd Font Propo' size='larger'></span>",
      ],
    },
    "on-click": "pwvucontrol",
  },
  "tray": { "icon-size": 21, "spacing": 10 },
}
