# Fish syntax; explicitly source this file after making a private .env copy.
set -gx MCP_WIKI_URL 'https://wiki.example.invalid/mcp'
set -gx MCP_WIKI_AUTHORIZATION 'Bearer REPLACE_ME'
set -gx MCP_KAITEN_URL 'https://kaiten.example.invalid/mcp'
set -gx MCP_KAITEN_AUTHORIZATION 'Bearer REPLACE_ME'
