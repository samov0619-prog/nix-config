{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "model": "copilot/x5-airun-code-large",
  "agents": {
    "title": {
      "model": "copilot/x5-airun-small"
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "copilot",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git push*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git pull*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git fetch*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git clone*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git ls-remote*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git remote update*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * push*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * pull*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * fetch*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * clone*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * ls-remote*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * remote update*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git remote show*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git remote set-head*--auto*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * remote show*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * remote set-head*--auto*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git remote add -f*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git remote add --fetch*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * remote add -f*"
    },
    {
      "action": "tool.use",
      "effect": "deny",
      "resource": "shell:git * remote add --fetch*"
    },
    {
      "action": "tool.use",
      "effect": "allow",
      "resource": "shell:git remote show -n*"
    },
    {
      "action": "tool.use",
      "effect": "allow",
      "resource": "shell:git remote show * -n*"
    },
    {
      "action": "tool.use",
      "effect": "allow",
      "resource": "shell:git * remote show -n*"
    },
    {
      "action": "tool.use",
      "effect": "allow",
      "resource": "shell:git * remote show * -n*"
    }
  ],
  "permissions": [
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git commit *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git * commit *"
    },
    {
      "action": "shell",
