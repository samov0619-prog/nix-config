  "providers": {
    "copilot": {
      "name": "copilot-x5",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [
        "COPILOT_API_KEY"
      ],
      "settings": {
        "baseURL": "https://api-copilot.x5.ru/v1/"
      },
      "models": {
        "x5-airun-code-large": {
          "body": {
            "reasoning_effort": "high"
          },
          "limit": {
            "context": 250000,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "x5-airun-small": {
          "limit": {
            "context": 250000,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "openai": {
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      }
    }
  },
  "mcp": {
    "servers": {
      "MCP-WIKI": {
        "type": "remote",
        "url": "{env:MCP_WIKI_URL}",
        "headers": {
          "Authorization": "{env:MCP_WIKI_AUTHORIZATION}"
        }
      },
      "MCP-KAITEN": {
        "type": "remote",
        "url": "{env:MCP_KAITEN_URL}",
        "oauth": false,
        "disabled": true,
        "headers": {
          "Authorization": "{env:MCP_KAITEN_AUTHORIZATION}"
        }
      },
      "MCP-XTRACKER": {
        "type": "remote",
        "url": "{env:MCP_XTRACKER_URL}",
        "oauth": false,
        "headers": {
          "Authorization": "{env:MCP_XTRACKER_AUTHORIZATION}"
        }
      },
      "MCP-GITLAB": {
        "type": "remote",
        "url": "{env:MCP_GITLAB_URL}",
        "oauth": false,
        "headers": {
          "Authorization": "{env:MCP_GITLAB_AUTHORIZATION}"
        }
      },
      "Chrome MCP": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browserUrl",
          "http://127.0.0.1:9222"
        ]
      },
      "MCP-HUB": {
        "url": "{env:MCP_HUB_URL}",
        "type": "remote",
        "headers": {
          "Authorization": "{env:MCP_HUB_AUTHORIZATION}"
        },
      },
      "Figma-Framelink": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "figma-developer-mcp",
          "--stdio"
        ],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        }
      },
    }
  }
}
