 void VpnConnection::connectToVpn(const QString &serverId, DockerContainer container, const QJsonObject &vpnConfiguration)
 {
+#ifdef Q_OS_LINUX
+    monitorLinuxNetwork();
+    m_linuxConnection.request();
+    m_linuxStartConnection = [this, serverId, container, vpnConfiguration]() {
+        startVpnConnection(serverId, container, vpnConfiguration);
+    };
+    setConnectionState(Vpn::ConnectionState::Connecting);
+    resumeLinuxConnection();
+#else
+    startVpnConnection(serverId, container, vpnConfiguration);
+#endif
+}
+
+#ifdef Q_OS_LINUX
+void VpnConnection::monitorLinuxNetwork()
+{
+    if (m_linuxNetworkMonitorConnected)
+        return;
+    IpcClient::withInterface([this](QSharedPointer<IpcInterfaceReplica> rep) {
+        m_linuxNetworkMonitorConnected = true;
+        connect(rep.data(), &IpcInterfaceReplica::linuxNetworkStateChanged, this,
+                &VpnConnection::linuxNetworkChanged);
+        connect(rep.data(), &QRemoteObjectReplica::stateChanged, this,
+                [this, rep](QRemoteObjectReplica::State state) {
+            if (state == QRemoteObjectReplica::Valid)
+                queryLinuxNetwork(rep);
+            else
+                linuxNetworkChanged(0);
+        });
+        queryLinuxNetwork(rep);
+    }, [this]() {
+        // Preserve existing service-error handling if IPC is unavailable.
+        linuxNetworkChanged(-1);
+    });
+}
+
+void VpnConnection::queryLinuxNetwork(const QSharedPointer<IpcInterfaceReplica> &rep)
+{
+    const unsigned revision = m_linuxNetworkRevision;
+    auto *watcher = new QRemoteObjectPendingCallWatcher(rep->linuxNetworkState(), this);
+    connect(watcher, &QRemoteObjectPendingCallWatcher::finished, this,
+            [this, watcher, revision]() {
+        QRemoteObjectPendingReply<int> reply(*watcher);
+        // A newer signal wins over an older initial-state reply.
+        if (revision == m_linuxNetworkRevision)
+            linuxNetworkChanged(reply.error() == QRemoteObjectPendingCall::NoError ? reply.returnValue() : 0);
+        watcher->deleteLater();
+    });
+}
+
+void VpnConnection::linuxNetworkChanged(int state)
+{
+    ++m_linuxNetworkRevision;
+    m_linuxConnection.networkChanged(state);
+    // Queuing coalesces ready events and rechecks cancellation/current state.
+    QTimer::singleShot(0, this, &VpnConnection::resumeLinuxConnection);
+}
+
+void VpnConnection::resumeLinuxConnection()
+{
+    using Action = AmneziaLinuxNetworking::ConnectionState::Action;
+    switch (m_linuxConnection.takeAction()) {
+    case Action::Start: {
+        auto start = std::move(m_linuxStartConnection);
+        if (start)
+            start();
+        break;
+    }
+    case Action::Reconnect:
+        reconnectToVpn();
+        break;
+    case Action::None:
+        break;
+    }
+}
